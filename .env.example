# =================================================================
# ThirdEye — Environment Configuration Template
# =================================================================
# Copy this file to .env and configure the values for your environment:
#   copy .env.example .env
#
# DO NOT commit .env containing real passwords to version control.
# =================================================================

# Flask Application Secret Key (generate a secure random string for production)
THIRDEYE_SECRET_KEY=CHANGE_ME_TO_A_SECURE_RANDOM_SECRET

# MySQL Database Configuration
THIRDEYE_DB_HOST=localhost
THIRDEYE_DB_PORT=3306
THIRDEYE_DB_USER=root
THIRDEYE_DB_PASSWORD=CHANGE_ME
THIRDEYE_DB_NAME=thirdeye_db

# Initial Administrator Account (optional, used by init-db or create_admin.py)
# THIRDEYE_ADMIN_USER=admin
# THIRDEYE_ADMIN_PASSWORD=CHANGE_ME_TO_A_SECURE_PASSWORD

# Optional: Direct SQLAlchemy URI Override
# SQLALCHEMY_DATABASE_URI=mysql+mysqlconnector://root:password@localhost:3306/thirdeye_db
